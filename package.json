{
  "name": "meetmind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100 -H 0.0.0.0",
    "prebuild": "node scripts/copy-audio-assets.mjs",
    "build": "next build",
    "start": "next start -p 3100 -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "email:verify": "tsx scripts/verify-email.ts",
    "interpreter": "tsx --conditions=react-server scripts/interpreter-agent.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/rtc-node": "1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.10.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.6",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.54.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
