# Automatic HTTPS (Let's Encrypt) for APP_DOMAIN. DNS must point at this host; ports 80/443 open.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# LiveKit signalling (WebSocket) on the same origin → browsers need no extra certificate or CORS.
	@livekit path /rtc /rtc/*
	reverse_proxy @livekit 127.0.0.1:7880

	reverse_proxy 127.0.0.1:3100 {
		# Replace any client-supplied X-Forwarded-For with the real peer address.
		header_up X-Forwarded-For {remote_host}
	}
}
