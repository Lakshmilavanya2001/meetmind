# ─── App ────────────────────────────────────────────────────────────────
# Public base URL used in emailed links (the HTTPS proxy address).
APP_URL=https://localhost:3443
# Set to "true" when served over HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
# Set to true ONLY when every request reaches the app through your reverse proxy (it appends the
# real client IP to X-Forwarded-For). Used for per-IP rate limits and audit logs.
TRUST_PROXY=false
# 32-byte key (base64) used to encrypt integration credentials at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Database (PostgreSQL 16 + pgvector) ────────────────────────────────
DATABASE_URL=postgresql://meetmind:meetmind_dev_password@localhost:5433/meetmind
TEST_DATABASE_URL=postgresql://meetmind:meetmind_dev_password@localhost:5433/meetmind_test

# ─── LiveKit (Phase 2) ──────────────────────────────────────────────────
# Self-hosted: keys must match infra/livekit.yaml. LiveKit Cloud: use project keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── LLM (OpenAI-compatible chat completions with tool calling) ─────────
LLM_BASE_URL=http://10.79.253.112:8000/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=not-needed
# Qwen "thinking" mode: slower, rarely needed for tool use.
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_MS=120000

# ─── Embeddings (OpenAI-compatible /v1/embeddings) ──────────────────────
EMBEDDING_BASE_URL=http://10.79.253.112:8001/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_DIMENSIONS=2048
EMBEDDING_API_KEY=not-needed
# Optional instruction prefixes for models that need them (nemotron-embed retrieved better without).
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
EMBEDDING_BATCH_SIZE=32

# ─── Speech-to-text (OpenAI-compatible /v1/audio/transcriptions) ────────
STT_BASE_URL=http://10.79.253.112:8094/v1
STT_MODEL=ibm-granite/granite-speech-4.1-2b
STT_API_KEY=not-needed
# Optional ISO language hint, e.g. en
STT_LANGUAGE=

# Where audio chunks wait for transcription (deleted after processing). Keep it off the web root.
UPLOAD_DIR=uploads
# Set to true to run without the in-process transcription worker (e.g. a separate worker deployment).
DISABLE_WORKERS=false

# ─── Text-to-speech for spoken assistant replies (optional) ───────────
# Qwen3-TTS: the voice is designed once from TTS_VOICE_DESCRIPTION, then reused. Without it, the browser's voice is used.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
TTS_VOICE_DESCRIPTION=

# ─── NVIDIA Riva streaming ASR (optional, preferred when set) ──────────
# Punctuation, Hindi (hi-IN), speaker diarization. Falls back to STT_* on outage.
RIVA_REALTIME_URL=
RIVA_API_KEY=
RIVA_ASR_MODEL=cache-aware-parakeet-rnnt-multi-asr-streaming-sortformer

# ─── Email (SMTP) for meeting invitations ───────────────────────────────
# Gmail: smtp.gmail.com, port 465, a Google *App Password* (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ─── Microsoft Teams connector (future; leave blank to keep disabled) ───
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# SMS (reminders, phone verification) via Twilio. Without it, SMS is off unless SMS_DEV_OUTBOX=true (development).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A sending number (+1555…) or a Messaging Service SID (MG…)
TWILIO_FROM=
SMS_ALLOWED_PREFIXES=+91
SMS_DAILY_LIMIT_PER_USER=20
SMS_DAILY_LIMIT=2000
# Development only: record texts (including verification codes) in Settings → Text messages instead of sending them.
SMS_DEV_OUTBOX=true

# Live AI interpreter (npm run interpreter): pause that ends a sentence, in ms.
INTERPRETER_PAUSE_MS=800

# Development only: record emails in Settings → Messages instead of sending them (never in production).
EMAIL_DEV_OUTBOX=true

# Indic speech stack (IndicConformer ASR, indic-translate, indic-speak). Unset: Riva/Qwen are used.
INDIC_ASR_URL=
INDIC_TRANSLATE_URL=
INDIC_TTS_URL=

# Agent orchestration: "langgraph" (default) or "classic" (the original loop, same steps).
# AGENT_ENGINE=langgraph

# NVIDIA Magpie TTS Multilingual NIM: the voice for calls (interpreter) and spoken assistant replies.
# 12 languages: en, hi, es, fr, de, it, pt, zh, ja, ko, ar, vi. MAGPIE_VOICE picks the speaker (default Louise).
MAGPIE_TTS_URL=
# MAGPIE_VOICE=Louise

# "Open in Uber" on cab results. Uber's links place pins by coordinates, looked up from the place names.
# GEOCODER_URL speaks the Nominatim search API: the public server (1 request/s; put a contact in GEOCODER_CONTACT)
# or a self-hosted one. Leave it empty to pass only the addresses. UBER_CLIENT_ID is optional (attribution).
GEOCODER_URL=
GEOCODER_CONTACT=
GEOCODER_COUNTRIES=in
UBER_CLIENT_ID=
